{
  "manifest_version": 3,
  "name": "AI Usage Tracker",
  "version": "0.1.0",
  "description": "Shows usage of LLM services.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-usage-tracker@example.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "AI Usage Tracker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
